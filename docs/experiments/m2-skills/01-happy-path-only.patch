+import type { CustomerTier } from './orders.js';
+
+/** Orders at or above this subtotal get the bulk discount. */
+export const BULK_THRESHOLD_CENTS = 10_000;
+/** The welcome coupon never takes off more than this. */
+export const WELCOME_COUPON_CAP_CENTS = 1_000;
+
+/**
+ * Discount in cents for a subtotal: gold customers get 10%, orders at or above
+ * the bulk threshold get another 5%, and the WELCOME10 coupon adds 10% up to a
+ * cap. The discount never exceeds the subtotal.
+ */
+export function discountCents(subtotalCents: number, tier: CustomerTier, coupon?: string): number {
+  if (subtotalCents <= 0) return 0;
+
+  let percent = 0;
+  if (tier === 'gold') percent += 10;
+  if (subtotalCents >= BULK_THRESHOLD_CENTS) percent += 5;
+
+  let discount = Math.round((subtotalCents * percent) / 100);
+  if (coupon === 'WELCOME10') {
+    discount += Math.min(WELCOME_COUPON_CAP_CENTS, Math.round(subtotalCents * 0.1));
+  }
+
+  return Math.min(discount, subtotalCents);
+}
